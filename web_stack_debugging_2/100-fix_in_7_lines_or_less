#!/usr/bin/env bash
# Configures nginx to run as the nginx user and listen on port 8080
pkill "apache2|nginx"
sed -i 's/^#\?user [a-z-]*/user nginx/' /etc/nginx/nginx.conf
sed -i --follow-symlinks 's/\b80\b/8080/g' /etc/nginx/sites-enabled/default
chown -R nginx:nginx /var/log/nginx /etc/nginx/nginx.conf
su -s /bin/bash nginx -c "service nginx restart"
